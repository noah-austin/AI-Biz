# Copy to .env (chmod 600). Never commit .env.
DATABASE_URL=postgresql://hub_app:CHANGE_ME@127.0.0.1:5432/hub
# At least 32 random characters: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=
# Which client folder this install serves.
CLIENT_DIR=clients/demo
# Password for the AI's read-only database login (ai_reader).
AI_READER_PASSWORD=
# Set to 0 only for local testing without HTTPS.
SECURE_COOKIES=1
# Claude API keys, one per AI feature so each has its own spend and can be revoked alone.
# Set them with: python -m kit.manage set-secret ANTHROPIC_API_KEY_CHAT   (hidden typing)
ANTHROPIC_API_KEY_CHAT=
ANTHROPIC_API_KEY_INSIGHTS=
